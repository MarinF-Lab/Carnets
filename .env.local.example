# Copia este archivo como .env.local y completa con los valores de
# Consola de Firebase → Configuración del proyecto → Tus apps → App web.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Solo desarrollo: 1 = usar los emuladores locales de Firebase (auth:9099, firestore:8080)
# NEXT_PUBLIC_USE_EMULATORS=1
