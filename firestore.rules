rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function docPath(coll, id) {
      return /databases/$(database)/documents/$(coll)/$(id);
    }

    // Administrador: entra con Google y su correo está autorizado en admins/{email}.
    function isAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && exists(docPath('admins', request.auth.token.email));
    }

    function me() {
      return get(docPath('users', request.auth.uid)).data;
    }

    // Usuario: entra con usuario + contraseña del grupo; activo y con grupo.
    function isMember() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(docPath('users', request.auth.uid))
        && me().active == true
        && me().get('groupId', null) is string;
    }

    // Puede ver/agregar datos del grupo g.
    function inGroup(g) {
      return isAdmin() || (isMember() && me().groupId == g);
    }

    function validUser(d) {
      return d.username is string
        && d.username.matches('^[a-z0-9][a-z0-9._-]{1,29}$')
        && d.groupId is string
        && exists(docPath('groups', d.groupId))
        && d.active is bool;
    }

    // ---------- Administración (solo admins) ----------

    match /admins/{email} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email == email);
      allow create: if isAdmin();
      // Un admin no puede quitarse a sí mismo.
      allow delete: if isAdmin() && email != request.auth.token.email;
      allow update: if false;
    }

    match /groups/{groupId} {
      allow read: if isAdmin() || (isMember() && me().groupId == groupId);
      allow create, update: if isAdmin() && request.resource.data.name is string && request.resource.data.name.size() > 0;
      allow delete: if false;
    }

    // Contraseña de cada grupo: solo la ven y cambian los admins.
    match /groupSecrets/{groupId} {
      allow read, write: if isAdmin();
    }

    // Clave de acceso: ID = SHA-256 de la contraseña del grupo → { groupId, name }.
    // Se puede consultar por ID (hay que conocer la contraseña), nunca listar.
    match /groupKeys/{key} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // Registro propio: el usuario se crea a sí mismo con la clave de su grupo.
    function validSelfRegistration(uid) {
      let d = request.resource.data;
      return signedIn()
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'password'
        && d.keys().hasOnly(['username', 'groupId', 'joinKey', 'active', 'createdAt'])
        && validUser(d)
        && d.active == true
        // El nombre de usuario debe ser el de su cuenta (nadie toma el de otro).
        && request.auth.token.email == d.username + '@usuarios.carnets.app'
        && d.joinKey is string
        && exists(docPath('groupKeys', d.joinKey))
        && get(docPath('groupKeys', d.joinKey)).data.groupId == d.groupId;
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // Los usuarios solo se crean a sí mismos; el admin los desactiva o cambia de grupo.
      allow create: if validSelfRegistration(uid);
      allow update: if isAdmin()
        && validUser(request.resource.data)
        && request.resource.data.username == resource.data.username;
      allow delete: if false;
    }

    // ---------- Datos: los usuarios agregan y editan; eliminar es solo de admins ----------

    match /contractors/{contractorId} {
      allow read: if inGroup(resource.data.get('groupId', null));
      allow create: if inGroup(request.resource.data.groupId)
        && request.resource.data.cardCount == 0;
      allow update: if isAdmin()
        || (isMember()
            && resource.data.get('groupId', null) == me().groupId
            && (
              // Sumar 1 al contador al guardar un carnet.
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cardCount'])
                && request.resource.data.cardCount == resource.data.get('cardCount', 0) + 1)
              // Renombrar.
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
                && request.resource.data.name is string
                && request.resource.data.name.size() > 0
                && request.resource.data.name.size() <= 80)
            ));
      allow delete: if isAdmin();
    }

    match /cards/{cardId} {
      allow read: if inGroup(resource.data.get('groupId', null));
      allow create: if inGroup(request.resource.data.groupId)
        && get(docPath('contractors', request.resource.data.contractorId)).data.get('groupId', null) == request.resource.data.groupId;
      // Un usuario puede corregir nombre y RUT; eliminar es solo de admins.
      allow update: if isAdmin()
        || (isMember()
            && resource.data.get('groupId', null) == me().groupId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'rut', 'updatedAt', 'updatedByName'])
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && (request.resource.data.rut == null || request.resource.data.rut is string));
      allow delete: if isAdmin();

      match /images/{imageId} {
        allow read: if inGroup(get(docPath('cards', cardId)).data.get('groupId', null));
        allow create: if inGroup(getAfter(docPath('cards', cardId)).data.groupId);
        allow update, delete: if isAdmin();
      }
    }

    // Todo lo demás (incluidas allowedUsers y config de versiones anteriores), denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
